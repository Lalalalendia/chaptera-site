# Key-only Erida HTTPS ingress. Deploy ONLY after the verified key-only
# Ararra release is installed and operator acceptance confirms private bind.
# Public visitors see the login HTML, NOT any team data without a key.
# Nginx overwrites spoofable headers; Uvicorn trusts ONLY local Nginx.
limit_req_zone $binary_remote_addr zone=erida_edge:1m rate=10r/s;
limit_req_zone $binary_remote_addr zone=erida_login:1m rate=6r/m;

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name erida.chaptera.online;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/erida.chaptera.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/erida.chaptera.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    client_max_body_size 16m;

    add_header Strict-Transport-Security "max-age=300" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    limit_req_status 429;
    limit_req zone=erida_edge burst=25 nodelay;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    # Do not forward any Browser Basic credentials from cached old realms.
    proxy_set_header Authorization "";
    proxy_connect_timeout 2s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location = /v1/session {
        limit_req zone=erida_login burst=6 nodelay;
        proxy_pass http://127.0.0.1:8091;
    }
    location = /v1/session/password {
        return 404;
    }
    location = /v1/session/password/change {
        return 404;
    }
    location / {
        proxy_pass http://127.0.0.1:8091;
    }
}
