[Unit]
Description=ReadEra public-source chapter collector (explicit approval required)
Documentation=https://github.com/Lalalalendia/ararra/issues/83
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/chaptera-translator
# Defense in depth: this unit must never start as part of the API/translation
# rollout. The root-owned opt-in marker is created only after site permissions,
# robots/TLS acceptance, backup recovery and real disk/memory headroom proof.
ConditionPathExists=/etc/chaptera-translator/source-collection-enabled
ConditionPathExists=/opt/chaptera-translator/current/venv/bin/chaptera-server
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=simple
User=chaptera-translator
Group=chaptera-translator
WorkingDirectory=/var/lib/chaptera-translator
Environment=CHAPTERA_DB_PATH=/var/lib/chaptera-translator/jobs.sqlite3
Environment=CHAPTERA_WORKER_POLL_SECONDS=4.0
Environment=PYTHONDONTWRITEBYTECODE=1
# No Gemini API key, vault key, moderator keys, Drive OAuth or cloud account.
# Site policy and logical source quotas are read from the same pinned Ararra.
ExecStart=/opt/chaptera-translator/current/venv/bin/chaptera-server source-worker
Restart=on-failure
RestartSec=15s
KillSignal=SIGTERM
TimeoutStopSec=90s
StateDirectory=chaptera-translator
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
MemoryAccounting=yes
MemoryHigh=112M
MemoryMax=160M
CPUAccounting=yes
CPUQuota=35%
TasksMax=48
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
