[Unit]
Description=Chaptera Gemini translation worker (single-process)
Wants=network-online.target
After=network-online.target
# Enabled units must remain inert before the first verified release install.
ConditionPathExists=/opt/chaptera-translator/current/venv/bin/chaptera-server
RequiresMountsFor=/var/lib/chaptera-translator
StartLimitIntervalSec=90
StartLimitBurst=4

[Service]
Type=simple
User=chaptera-translator
Group=chaptera-translator
WorkingDirectory=/var/lib/chaptera-translator
Environment=CHAPTERA_DB_PATH=/var/lib/chaptera-translator/jobs.sqlite3
Environment=CHAPTERA_GEMINI_MODEL=gemini-3.8-flash
Environment=CHAPTERA_WORKER_POLL_SECONDS=2.0
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=gemini_api_key:/etc/chaptera-translator/credentials/gemini_api_key
ExecStart=/opt/chaptera-translator/current/venv/bin/chaptera-server worker
Restart=on-failure
RestartSec=10s
KillSignal=SIGTERM
TimeoutStopSec=240s
StateDirectory=chaptera-translator
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
MemoryAccounting=yes
MemoryHigh=160M
MemoryMax=240M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
